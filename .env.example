# Copy thành .env.local rồi điền key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# OrbPlay admin (/orbplay/admin): mật khẩu để lưu cấu hình
ORBPLAY_ADMIN_PASSWORD=
# Nơi lưu cấu hình OrbPlay dùng chung. Bỏ trống thì ghi file .data/orbplay.json (Vercel không ghi file được, phải có KV)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
